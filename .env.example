# =======================================================================
# どのLLMで回すか（Decision層とAgent層の両方がこれに従う）
#   anthropic … Anthropic API + Claude Agent SDK
#   openai    … OpenAI互換エンドポイント（Ollama / llama.cpp / vLLM / LM Studio）
# =======================================================================
AION_LLM_PROVIDER=anthropic

# --- provider=anthropic のとき -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# AION_DECISION_MODEL=claude-opus-5
# AION_AGENT_MODEL=claude-opus-5
# AION_AGENT_MAX_TURNS=12

# --- provider=openai（ローカルLLM）のとき ------------------------------
# ローカルのモデル名は環境ごとに違うので既定値は無い。必ず指定すること。
# AION_LLM_BASE_URL=http://localhost:11434/v1   # Ollama
# AION_LLM_BASE_URL=http://localhost:8000/v1    # vLLM
# AION_LLM_BASE_URL=http://localhost:1234/v1    # LM Studio
# AION_LLM_API_KEY=local
# AION_DECISION_MODEL=qwen3:8b
# AION_AGENT_MODEL=qwen3:8b
# AION_AGENT_MAX_STEPS=8
#
# 応答形式の指定。既定の auto は json_schema → json_object → 指定なし の順に
# 試して、通った形式を記憶する。サーバの対応が分かっているなら固定してよい。
# AION_RESPONSE_FORMAT_MODE=auto

# --- Observation --------------------------------------------------------
# 公式RSSでも、RSSHubが生成したフィードURLでも同じように使える。
AION_FEED_URL=https://feeds.bbci.co.uk/news/world/rss.xml
AION_FEED_NAME=world-news
AION_FEED_LIMIT=5

# --- World State --------------------------------------------------------
AION_DB_PATH=aion.db

# --- Loop ---------------------------------------------------------------
AION_INTERVAL_SECONDS=300
# 1周で作るWorkの上限。再評価が create_work を返し続けても暴走しない。
AION_MAX_WORKS_PER_CYCLE=1
